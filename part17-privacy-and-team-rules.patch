diff --git a/src/components/AccountDangerZone.tsx b/src/components/AccountDangerZone.tsx
new file mode 100644
index 0000000..037f8d7
--- /dev/null
+++ b/src/components/AccountDangerZone.tsx
@@ -0,0 +1,113 @@
+import { useEffect, useState } from "react";
+import { useNavigate } from "@tanstack/react-router";
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { useServerFn } from "@tanstack/react-start";
+import { toast } from "sonner";
+
+import { Button } from "@/components/ui/button";
+import { resetAuthCache } from "@/hooks/useFellogramAuth";
+import { supabase } from "@/integrations/supabase/client";
+import { t } from "@/lib/i18n";
+import { deleteMyAccount, leaveTeam } from "@/lib/privacy.functions";
+
+const CONFIRM_WORDS = ["delete", "حذف"];
+
+/** A cashier stops working for their store (two taps). */
+export function LeaveTeamRow({ storeName }: { storeName: string }) {
+  const queryClient = useQueryClient();
+  const navigate = useNavigate();
+  const leave = useServerFn(leaveTeam);
+  const [confirming, setConfirming] = useState(false);
+
+  useEffect(() => {
+    if (!confirming) return;
+    const id = setTimeout(() => setConfirming(false), 4000);
+    return () => clearTimeout(id);
+  }, [confirming]);
+
+  const mutation = useMutation({
+    mutationFn: () => leave(),
+    onSuccess: async () => {
+      toast.success(t("settings.leftTeam"));
+      await queryClient.invalidateQueries({ queryKey: ["my-context"] });
+      void navigate({ to: "/wallet", replace: true });
+    },
+    onError: () => {
+      setConfirming(false);
+      toast.error(t("common.error"));
+    },
+  });
+
+  return (
+    <div>
+      <p className="text-xs text-muted-foreground">{t("settings.leaveTeam.hint")}</p>
+      <Button
+        type="button"
+        variant={confirming ? "destructive" : "outline"}
+        disabled={mutation.isPending}
+        className="touch-action mt-2 h-11 w-full font-semibold"
+        onClick={() => (confirming ? mutation.mutate() : setConfirming(true))}
+      >
+        {confirming ? t("team.confirmRemove") : t("settings.leaveTeam", { store: storeName })}
+      </Button>
+    </div>
+  );
+}
+
+/** Delete my account and data. Owners are told to delete their store first (the server refuses too). */
+export function DeleteAccountSection({ isOwner }: { isOwner: boolean }) {
+  const queryClient = useQueryClient();
+  const navigate = useNavigate();
+  const remove = useServerFn(deleteMyAccount);
+  const [typed, setTyped] = useState("");
+  const confirmed = CONFIRM_WORDS.includes(typed.trim().toLowerCase());
+
+  const mutation = useMutation({
+    mutationFn: () => remove({ data: { confirm: typed } }),
+    onSuccess: async () => {
+      // The account no longer exists: drop the local session and everything cached, then start over.
+      await supabase.auth.signOut({ scope: "local" });
+      resetAuthCache();
+      queryClient.clear();
+      toast.success(t("settings.deleted"));
+      void navigate({ to: "/", replace: true });
+    },
+    onError: (e: Error) =>
+      toast.error(
+        e.message.includes("OWNS_STORE") ? t("settings.delete.owner") : e.message.includes("PREVIEW_ACCOUNT") ? t("settings.delete.preview") : t("common.error"),
+      ),
+  });
+
+  return (
+    <div className="space-y-3">
+      <p className="text-xs text-muted-foreground">{t("settings.delete.body")}</p>
+      {isOwner ? (
+        <p role="note" className="rounded-md bg-muted px-3 py-2 text-xs font-semibold">
+          {t("settings.delete.owner")}
+        </p>
+      ) : (
+        <>
+          <label htmlFor="deleteConfirm" className="block text-xs font-semibold text-muted-foreground">
+            {t("settings.delete.confirmLabel", { word: t("settings.delete.word") })}
+          </label>
+          <input
+            id="deleteConfirm"
+            value={typed}
+            onChange={(event) => setTyped(event.target.value)}
+            autoComplete="off"
+            className="w-full rounded-md border border-border bg-background px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-destructive"
+          />
+          <Button
+            type="button"
+            variant="destructive"
+            disabled={!confirmed || mutation.isPending}
+            className="touch-action h-11 w-full font-semibold"
+            onClick={() => mutation.mutate()}
+          >
+            {mutation.isPending ? t("settings.delete.deleting") : t("settings.delete.action")}
+          </Button>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/RemoveCardSection.tsx b/src/components/RemoveCardSection.tsx
new file mode 100644
index 0000000..b987716
--- /dev/null
+++ b/src/components/RemoveCardSection.tsx
@@ -0,0 +1,53 @@
+import { useEffect, useState } from "react";
+import { useNavigate } from "@tanstack/react-router";
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { useServerFn } from "@tanstack/react-start";
+import { toast } from "sonner";
+
+import { Button } from "@/components/ui/button";
+import { t } from "@/lib/i18n";
+import { leaveStore } from "@/lib/privacy.functions";
+
+/** A customer removes their own card for one store. Two taps, and the cost (lost stamps) is spelled out. */
+export function RemoveCardSection({ storeId, storeName, balance }: { storeId: string; storeName: string; balance: number }) {
+  const queryClient = useQueryClient();
+  const navigate = useNavigate();
+  const remove = useServerFn(leaveStore);
+  const [confirming, setConfirming] = useState(false);
+
+  // The "tap again" step lapses on its own so a stray tap never removes the card later.
+  useEffect(() => {
+    if (!confirming) return;
+    const id = setTimeout(() => setConfirming(false), 4000);
+    return () => clearTimeout(id);
+  }, [confirming]);
+
+  const mutation = useMutation({
+    mutationFn: () => remove({ data: { storeId } }),
+    onSuccess: async () => {
+      toast.success(t("wallet.removed"));
+      await queryClient.invalidateQueries({ queryKey: ["my-cards"] });
+      void navigate({ to: "/wallet", replace: true });
+    },
+    onError: () => {
+      setConfirming(false);
+      toast.error(t("common.error"));
+    },
+  });
+
+  return (
+    <div className="mt-8 rounded-lg border border-border bg-card p-4">
+      <p className="text-sm font-bold">{t("wallet.remove.title")}</p>
+      <p className="mt-1 text-xs text-muted-foreground">{t("wallet.remove.body", { count: balance, store: storeName })}</p>
+      <Button
+        type="button"
+        variant={confirming ? "destructive" : "outline"}
+        disabled={mutation.isPending}
+        className="touch-action mt-3 h-11 w-full font-semibold"
+        onClick={() => (confirming ? mutation.mutate() : setConfirming(true))}
+      >
+        {confirming ? t("team.confirmRemove") : t("wallet.remove.action")}
+      </Button>
+    </div>
+  );
+}
diff --git a/src/components/TeamRulesCard.tsx b/src/components/TeamRulesCard.tsx
new file mode 100644
index 0000000..d6758cb
--- /dev/null
+++ b/src/components/TeamRulesCard.tsx
@@ -0,0 +1,68 @@
+import { useState } from "react";
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { useServerFn } from "@tanstack/react-start";
+import { toast } from "sonner";
+
+import { Button } from "@/components/ui/button";
+import { Switch } from "@/components/ui/switch";
+import { t } from "@/lib/i18n";
+import { updateTeamRules } from "@/lib/team.functions";
+
+type Rules = { supported: boolean; canUndo: boolean; dailyLimit: number };
+
+/** Owner-set limits for cashiers: whether they can undo a stamp, and a rolling 24-hour stamp cap. */
+export function TeamRulesCard({ rules }: { rules: Rules }) {
+  const queryClient = useQueryClient();
+  const save = useServerFn(updateTeamRules);
+  const [canUndo, setCanUndo] = useState(rules.canUndo);
+  const [limitText, setLimitText] = useState(String(rules.dailyLimit));
+
+  const dailyLimit = Math.min(1000, Math.max(0, Math.round(Number(limitText)) || 0));
+  const dirty = canUndo !== rules.canUndo || dailyLimit !== rules.dailyLimit;
+
+  const mutation = useMutation({
+    mutationFn: () => save({ data: { canUndo, dailyLimit } }),
+    onSuccess: async () => {
+      toast.success(t("team.rules.saved"));
+      await queryClient.invalidateQueries({ queryKey: ["team"] });
+    },
+    onError: (e: Error) => toast.error(e.message.includes("DB_MIGRATION_REQUIRED") ? t("error.migrationNeeded") : t("common.error")),
+  });
+
+  return (
+    <div className="mt-8 rounded-lg border border-border bg-card p-4 shadow-[var(--shadow-card)]">
+      <h2 className="text-sm font-bold">{t("team.rules.title")}</h2>
+      {!rules.supported ? (
+        <p className="mt-2 rounded-md bg-muted px-3 py-2 text-xs text-muted-foreground">{t("error.migrationNeeded")}</p>
+      ) : (
+        <div className="mt-3 space-y-4">
+          <div className="flex min-h-11 items-center justify-between gap-3">
+            <label htmlFor="teamCanUndo" className="min-w-0 text-sm font-medium">
+              {t("team.rules.canUndo")}
+            </label>
+            <Switch id="teamCanUndo" checked={canUndo} onCheckedChange={setCanUndo} />
+          </div>
+          <div>
+            <label htmlFor="teamDailyLimit" className="text-sm font-medium">
+              {t("team.rules.dailyLimit")}
+            </label>
+            <input
+              id="teamDailyLimit"
+              type="number"
+              inputMode="numeric"
+              min={0}
+              max={1000}
+              value={limitText}
+              onChange={(event) => setLimitText(event.target.value)}
+              className="mt-1 w-28 rounded-md border border-border bg-background px-4 py-3 text-center text-sm outline-none focus:ring-2 focus:ring-ring"
+            />
+            <p className="mt-1 text-xs text-muted-foreground">{t("team.rules.dailyLimit.hint")}</p>
+          </div>
+          <Button type="button" disabled={!dirty || mutation.isPending} onClick={() => mutation.mutate()} className="touch-action h-11 w-full font-bold">
+            {mutation.isPending ? t("program.saving") : t("team.rules.save")}
+          </Button>
+        </div>
+      )}
+    </div>
+  );
+}
